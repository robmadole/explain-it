{
  "name": "@explain-it/core",
  "version": "0.2.0",
  "description": "Agent-driven animated explainers, built on Motion Canvas.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robmadole/explain-it.git",
    "directory": "packages/core"
  },
  "bin": {
    "explainer": "bin/explainer.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./runtime/*": "./dist/runtime/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@motion-canvas/2d": "~3.17.2",
    "@motion-canvas/core": "~3.17.2",
    "esbuild": "^0.21.5",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
